{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "rootDir": "./src",
    "outDir": "./dist",
    
    /* Strict Type-Checking Options as required */
    "strict": true,
    "noImplicitAny": true,
    
    /* Interoperability & Environment */
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    
    /* Types */
    "types": ["node"]
  },
  "include": ["src/**/*"]
}